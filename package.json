{
  "name": "bunker-Online",
  "version": "1.4.2",
  "description": "Создание и редактирование личных паков для bunker-online.com",
  "main": "electron/main.mjs",
  "author": "chikda3301",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "build:win": "vite build && electron-builder --win"
  },
  "allowScripts": {
    "electron@35.7.5": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^35.7.5",
    "electron-builder": "^26.15.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.2.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.chikada3301.bunkerpacks",
    "productName": "Bunker Packs Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "src/img/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "src/img/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Bunker Packs Editor"
    }
  }
}
